{
  "name": "weildbuild-server",
  "version": "1.1.0",
  "private": true,
  "description": "WeildBuild platform servers: Main Server (REST API + orchestration), Realtime (presence/chat), Game Host (game instances). Deploys to Render, database on Neon.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start:main": "node dist/main/index.js",
    "start:realtime": "node dist/realtime/index.js",
    "start:gamehost": "node dist/gamehost/index.js",
    "dev:main": "tsx watch src/main/index.ts",
    "dev:realtime": "tsx watch src/realtime/index.ts",
    "dev:gamehost": "tsx watch src/gamehost/index.ts",
    "migrate": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm run migrate && npm run seed",
    "test:compat": "tsx tests/compat.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
