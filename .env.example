# ═══════════════════════════════════════════════════════════
# WeildBuild Server — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env for local dev. On Render, set these in each
# service's Environment tab (see DEPLOY.md for exact values).
# NEVER commit real secrets.

# ─── Database (Neon Postgres) — REQUIRED on ALL services ───
# Create free at https://neon.tech → copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── Auth (shared by ALL services) — REQUIRED ───
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be identical on main, realtime and both game hosts.
AUTH_SECRET=paste-a-long-random-string-here

# ─── Server-to-server token (main <-> game hosts) — REQUIRED ───
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_TOKEN=paste-another-random-string-here

# ─── CORS: which client origins may call the servers ───
# Tauri desktop app origins + local dev. Comma-separated.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:3000,http://localhost:8000

# ─── Port (Render sets this automatically; local defaults inside code) ───
# PORT=8000

# ═══════════════ MAIN SERVER ONLY ═══════════════

# ─── Backblaze B2 storage (same keys as before, four buckets) ───
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_ASSETS_BUCKET=weildbuild
B2_GAMEFILES_BUCKET=weildbuild-gamefiles
B2_REPORTS_BUCKET=weildbuild-reports
B2_BACKUPS_BUCKET=weildbuild-backups

# ─── Client version gate (roadmap 2.5) ───
CLIENT_LATEST_VERSION=13.1.0
CLIENT_MIN_VERSION=13.0.0
CLIENT_DOWNLOAD_URL=https://weildbuild.vercel.app

# ═══════════════ GAME HOST ONLY ═══════════════

# URL of the Main Server (no trailing slash)
MAIN_SERVER_URL=https://weildbuild-main.onrender.com
# This host's public URL — Render provides $RENDER_EXTERNAL_URL automatically;
# for local dev set it manually.
HOST_PUBLIC_URL=http://localhost:3004
# Identity of this host
HOST_ID=server-1
HOST_LABEL=Server 1
HOST_PRIORITY=1
# Max simultaneous game instances on this host (free tier: keep ≤ 6)
MAX_INSTANCES_PER_HOST=6
# Max players per game instance (user spec: 10)
MAX_PLAYERS_PER_INSTANCE=10
# How long an empty instance waits before being deleted (ms). 0 = instantly.
EMPTY_GRACE_MS=20000
# How often the host reports its state to the Main Server (ms)
HEARTBEAT_INTERVAL_MS=15000

# ═══════════════ KEEP-AWAKE (no extra service!) ═══════════════

# Render free tier sleeps services after 15 min without traffic.
# Keep everything awake with a FREE external monitor bot instead:
# UptimeRobot (uptimerobot.com) or cron-job.org — one monitor per
# service, hitting /health every 5 minutes. Click-by-click guide:
# DEPLOY.md section 6. No env vars needed here.
